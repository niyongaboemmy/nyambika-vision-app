// Nyambika core data model (SRS §8.1 + v2 change requests CR-02/05/06).
// Tenant isolation is enforced per page in the API layer (see docs/adr/0003-tenancy.md).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum Role {
  SHOPPER
  PAGE_OWNER
  PAGE_STAFF
  COOP_ADMIN
  COOP_MEMBER
  HOST_ADMIN
  MODERATOR
  DPO
  SUPPORT
}

enum MemberType {
  TAILOR
  COOPERATIVE
  SELLER
}

enum PageStatus {
  DRAFT
  PENDING_VERIFICATION
  PUBLISHED
  PAUSED
  SUSPENDED
  CLOSED
}

enum ProductStatus {
  DRAFT
  PENDING_APPROVAL
  PUBLISHED
  OUT_OF_STOCK
  ARCHIVED
}

enum TryOnReadiness {
  NOT_ASSESSED
  READY
  NEEDS_BETTER_PHOTO
  NOT_SUPPORTED
}

enum PayoutTarget {
  PAGE
  MAKER
}

enum OrderStatus {
  NEW
  AWAITING_PAYMENT
  PAID
  ACCEPTED
  DECLINED
  IN_PREPARATION
  READY
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
  DISPUTED
  RESOLVED
}

enum GenerationStatus {
  QUEUED
  GENERATING
  GUARDING
  DELIVERED
  WITHHELD
  FAILED
}

model User {
  id          String           @id @default(cuid())
  phone       String           @unique
  name        String?
  locale      String           @default("en")
  createdAt   DateTime         @default(now())
  deletedAt   DateTime?
  roles       RoleAssignment[]
  sessions    Session[]
  twins       Twin[]
  consents    ConsentRecord[]
  intents     IntentSession[]
  looks       Look[]
  generations Generation[]
  orders      Order[]          @relation("ShopperOrders")
  follows     Follow[]
  usage       UsageEvent[]
}

model OtpChallenge {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
}

model Session {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshHash String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
}

model RoleAssignment {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role
  pageId    String?
  page      Page?    @relation(fields: [pageId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, role, pageId])
}

model Page {
  id             String           @id @default(cuid())
  handle         String           @unique
  name           String
  memberType     MemberType
  status         PageStatus       @default(DRAFT)
  verified       Boolean          @default(false)
  story          String           @default("")
  district       String           @default("")
  sector         String           @default("")
  whatsapp       String           @default("")
  instagram      String           @default("")
  theme          String           @default("terra")
  momoMerchant   String           @default("")
  airtelMerchant String           @default("")
  allowanceOn    Boolean          @default(true)
  rating         Float            @default(0)
  reviewCount    Int              @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  roles          RoleAssignment[]
  products       Product[]
  makers         CoopMember[]
  orders         Order[]
  follows        Follow[]
  subscription   Subscription?
  sizeCharts     SizeChart[]
  usage          UsageEvent[]
}

model Follow {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, pageId])
}

/// A maker inside a cooperative page (FR-COOP-02/04/05).
model CoopMember {
  id                   String         @id @default(cuid())
  pageId               String
  page                 Page           @relation(fields: [pageId], references: [id], onDelete: Cascade)
  userId               String?
  name                 String
  phone                String         @default("")
  momoMerchant         String         @default("")
  active               Boolean        @default(true)
  attributionConsent   Boolean        @default(true)
  createdAt            DateTime       @default(now())
  products             ProductMaker[]
}

model SizeChart {
  id        String    @id @default(cuid())
  pageId    String
  page      Page      @relation(fields: [pageId], references: [id], onDelete: Cascade)
  name      String
  /// [{size:"M", chestCm:[88,94], heightRatio:[0.24,0.27]}]
  rows      Json
  products  Product[]
}

model Product {
  id             String                       @id @default(cuid())
  pageId         String
  page           Page                         @relation(fields: [pageId], references: [id], onDelete: Cascade)
  title          String
  description    String                       @default("")
  category       String
  priceRwf       Int
  madeToOrder    Boolean                      @default(false)
  leadTimeDays   Int                          @default(0)
  styles         String[]
  occasions      String[]
  fabric         String                       @default("")
  status         ProductStatus                @default(DRAFT)
  readiness      TryOnReadiness               @default(NOT_ASSESSED)
  readinessNotes String[]
  qualityScore   Float?
  payoutTarget   PayoutTarget                 @default(PAGE)
  featured       Boolean                      @default(false)
  submittedById  String?
  sizeChartId    String?
  sizeChart      SizeChart?                   @relation(fields: [sizeChartId], references: [id])
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt
  variants       Variant[]
  media          MediaAsset[]
  makers         ProductMaker[]

  @@index([pageId, status])
}

model ProductMaker {
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  coopMemberId String
  coopMember   CoopMember @relation(fields: [coopMemberId], references: [id], onDelete: Cascade)

  @@id([productId, coopMemberId])
}

model Variant {
  id          String       @id @default(cuid())
  productId   String
  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  colourName  String
  colourHex   String
  sizes       String[]
  stock       Int          @default(0)
  /// Garment cut-out used for try-on (path in the media store).
  cutoutPath  String?
  imagePath   String?
  /// Snap visual-search embedding (pgvector, cosine).
  embedding   Unsupported("vector(64)")?
  generations Generation[]
}

model MediaAsset {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  kind      String   @default("ORIGINAL")
  path      String
  width     Int      @default(0)
  height    Int      @default(0)
  createdAt DateTime @default(now())
}

/// Persistent photo twin (CR-02). Image bytes are AES-256-GCM encrypted at rest.
model Twin {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  version     Int       @default(1)
  encPath     String
  iv          String
  authTag     String
  mime        String
  size        String?
  checks      Json
  consentId   String
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?
}

/// Append-only consent ledger with a hash chain (plan §17).
model ConsentRecord {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose       String
  granted       Boolean
  noticeVersion String
  locale        String
  prevHash      String
  hash          String   @unique
  createdAt     DateTime @default(now())
}

model IntentSession {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  input     String
  source    String
  intent    Json
  createdAt DateTime @default(now())
  looks     Look[]
}

model Look {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  intentSessionId String
  intentSession   IntentSession  @relation(fields: [intentSessionId], references: [id], onDelete: Cascade)
  productId       String
  variantId       String
  rank            Int
  score           Float          @default(0)
  generationId    String?
  generation      Generation?    @relation(fields: [generationId], references: [id], onDelete: SetNull)
  savedAt         DateTime?
  createdAt       DateTime       @default(now())

  @@index([userId, savedAt])
}

model Generation {
  id           String           @id @default(cuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  variantId    String
  variant      Variant          @relation(fields: [variantId], references: [id], onDelete: Cascade)
  twinVersion  Int
  modelVersion String
  tier         String           @default("PREVIEW")
  cacheKey     String           @unique
  status       GenerationStatus @default(QUEUED)
  outputPath   String?
  guard        Json?
  c2pa         Json?
  costRwf      Int              @default(0)
  latencyMs    Int?
  createdAt    DateTime         @default(now())
  deliveredAt  DateTime?
  looks        Look[]

  @@index([userId, createdAt])
}

/// Metering for every billable AI action (FR-PLAN-02/03).
model UsageEvent {
  id        String   @id @default(cuid())
  kind      String
  source    String
  units     Int      @default(1)
  costRwf   Int      @default(0)
  pageId    String?
  page      Page?    @relation(fields: [pageId], references: [id], onDelete: SetNull)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  refId     String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([pageId, createdAt])
}

model Plan {
  code           String         @id
  name           String
  priceRwf       Int
  maxProducts    Int
  tryOnAllowance Int
  staffSeats     Int
  subscriptions  Subscription[]
}

model Subscription {
  id          String   @id @default(cuid())
  pageId      String   @unique
  page        Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  planCode    String
  plan        Plan     @relation(fields: [planCode], references: [code])
  monthlyCap  Int
  periodStart DateTime @default(now())
  sponsor     String?
}

model Order {
  id             String       @id @default(cuid())
  code           String       @unique
  pageId         String
  page           Page         @relation(fields: [pageId], references: [id])
  shopperId      String
  shopper        User         @relation("ShopperOrders", fields: [shopperId], references: [id])
  status         OrderStatus  @default(NEW)
  totalRwf       Int
  deliveryMode   String
  deliveryFeeRwf Int          @default(0)
  address        String       @default("")
  wallet         String
  payerPhone     String
  payoutMsisdn   String
  payoutLabel    String
  idempotencyKey String       @unique
  lookId         String?
  readyBy        DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  items          OrderItem[]
  events         OrderEvent[]
  payments       Payment[]
  review         Review?

  @@index([pageId, createdAt])
  @@index([shopperId, createdAt])
}

model OrderItem {
  id           String @id @default(cuid())
  orderId      String
  order        Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  variantId    String
  title        String
  colourName   String
  size         String
  qty          Int    @default(1)
  unitPriceRwf Int
  makerName    String @default("")
}

model OrderEvent {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String      @default("")
  actorId   String?
  createdAt DateTime    @default(now())
}

model Payment {
  id          String    @id @default(cuid())
  orderId     String
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider    String
  providerRef String    @unique
  status      String    @default("PENDING")
  amountRwf   Int
  payerPhone  String
  merchant    String
  webhook     Json?
  reconciled  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  settledAt   DateTime?
}

model Review {
  id        String   @id @default(cuid())
  orderId   String   @unique
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  pageId    String
  rating    Int
  text      String   @default("")
  status    String   @default("PUBLISHED")
  createdAt DateTime @default(now())
}

/// Outbox for WhatsApp / SMS / push messages (SI-03/04).
model Notification {
  id        String   @id @default(cuid())
  channel   String
  to        String
  template  String
  body      String
  status    String   @default("SENT")
  refId     String?
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  pageId    String?
  action    String
  data      Json?
  createdAt DateTime @default(now())

  @@index([pageId, createdAt])
}

model ModerationItem {
  id         String    @id @default(cuid())
  kind       String
  refId      String
  pageId     String?
  reason     String
  status     String    @default("OPEN")
  resolvedBy String?
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
}

model FeatureFlag {
  key         String  @id
  enabled     Boolean @default(false)
  rollout     Int     @default(100)
  description String  @default("")
}

model ModelVersion {
  id        String   @id
  provider  String
  name      String
  version   String
  tier      String
  status    String   @default("ACTIVE")
  nlbScore  Float?
  costRwf   Int
  createdAt DateTime @default(now())
}

/// Deletion cascade jobs (FR-PRV, plan §17 twin protection).
model DeletionJob {
  id          String    @id @default(cuid())
  userId      String
  scope       String
  status      String    @default("PENDING")
  steps       Json
  createdAt   DateTime  @default(now())
  completedAt DateTime?
}

/// Migration of existing member pages (plan §16, FR-MIG-01..05).
model MigrationWave {
  id        String          @id @default(cuid())
  name      String
  status    String          @default("IMPORTED")
  createdBy String?
  createdAt DateTime        @default(now())
  items     MigrationItem[]
}

model MigrationItem {
  id          String        @id @default(cuid())
  waveId      String
  wave        MigrationWave @relation(fields: [waveId], references: [id], onDelete: Cascade)
  pageId      String        @unique
  legacyUrl   String
  checksum    String
  /// IMPORTED → IN_REVIEW → SIGNED_OFF → LIVE | CHANGES_REQUESTED | ROLLED_BACK
  status      String        @default("IMPORTED")
  defects     Json
  reviewToken String        @unique
  ownerNote   String        @default("")
  signedOffAt DateTime?
  liveAt      DateTime?
  createdAt   DateTime      @default(now())
}

/// Legacy URL → new Maker Space. Disabling a redirect is the per-page rollback.
model Redirect {
  fromPath  String   @id
  toPath    String
  active    Boolean  @default(false)
  hits      Int      @default(0)
  createdAt DateTime @default(now())
}

/// Unmatched legacy paths, for post-cutover 404 monitoring.
model NotFoundHit {
  path     String   @id
  hits     Int      @default(1)
  lastSeen DateTime @default(now())
}

// ==== E25 Ask your circle (FR-SOC-01..03, CR-09) ====

/// A private live poll the shopper shares with friends. Watermarked copies only; originals stay private.
model CirclePoll {
  id        String         @id @default(cuid())
  ownerId   String
  token     String         @unique
  question  String
  occasion  String?
  consentId String
  ogPath    String?
  expiresAt DateTime
  revokedAt DateTime?
  purgedAt  DateTime?
  createdAt DateTime       @default(now())
  options   CircleOption[]
  votes     CircleVote[]

  @@index([ownerId, createdAt])
  @@index([expiresAt])
}

model CircleOption {
  id        String       @id @default(cuid())
  pollId    String
  poll      CirclePoll   @relation(fields: [pollId], references: [id], onDelete: Cascade)
  position  Int
  lookId    String
  productId String
  variantId String
  label     String
  /// Watermarked copy (private/polls/...), served only while the poll is open.
  imagePath String
  votes     CircleVote[]
}

/// One vote per device per poll (signed device cookie); name and comment are optional.
model CircleVote {
  id         String       @id @default(cuid())
  pollId     String
  poll       CirclePoll   @relation(fields: [pollId], references: [id], onDelete: Cascade)
  optionId   String
  option     CircleOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  deviceHash String
  ipHash     String
  name       String?
  comment    String?
  emoji      String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([pollId, deviceHash])
  @@index([pollId, createdAt])
}

// ==== E26 Digital wardrobe (FR-WRD-01..03, CR-09) ====

/// An upcoming event the shopper wants to restyle owned pieces for.
model WardrobeEvent {
  id              String           @id @default(cuid())
  userId          String
  title           String
  occasion        String
  date            DateTime
  budgetMax       Int?
  intentSessionId String?
  reminderSentAt  DateTime?
  createdAt       DateTime         @default(now())
  outfits         WardrobeOutfit[]

  @@index([userId, date])
}

/// One AI outfit suggestion: owned pieces + 0–2 new maker items, rendered on the twin.
model WardrobeOutfit {
  id          String           @id @default(cuid())
  eventId     String
  event       WardrobeEvent    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId      String
  rank        Int
  /// [{ productId, variantId, category, owned }] in render order (bottom → top).
  items       Json
  reasons     String[]
  score       Float            @default(0)
  newCostRwf  Int              @default(0)
  status      GenerationStatus @default(QUEUED)
  outputPath  String?
  guard       Json?
  c2pa        Json?
  costRwf     Int              @default(0)
  createdAt   DateTime         @default(now())
  deliveredAt DateTime?

  @@index([userId, createdAt])
}

// ==== Phase 2 Pilot and evaluation (plan §8, §21, Gate 3) ====

/// A/B experiment. Assignment is deterministic: hash(userId + ":" + key) → weighted variant.
model Experiment {
  key           String    @id
  name          String
  description   String    @default("")
  /// [{ key, weight }]; the first variant is the control.
  variants      Json
  /// DRAFT | RUNNING | PAUSED | STOPPED. Only RUNNING inside [startsAt, endsAt) assigns.
  status        String    @default("DRAFT")
  primaryMetric String
  startsAt      DateTime?
  endsAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

/// First exposure of a user to an experiment arm (operational, never shared outside aggregates).
model ExperimentExposure {
  id            String   @id @default(cuid())
  experimentKey String
  userId        String
  variant       String
  synthetic     Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@unique([experimentKey, userId])
  @@index([experimentKey, variant])
}

/// Pseudonymised product analytics event. `pseudoId` = HMAC(user or device id); props are allow-listed, no PII.
model Event {
  id         String   @id @default(cuid())
  name       String
  pseudoId   String
  authed     Boolean  @default(false)
  props      Json
  synthetic  Boolean  @default(false)
  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([name, occurredAt])
  @@index([pseudoId, name])
}

/// In-app micro-survey ("Did this help you decide?" + NPS), at most once per user per trigger.
model SurveyResponse {
  id        String   @id @default(cuid())
  userId    String
  trigger   String
  helped    Boolean?
  nps       Int?
  dismissed Boolean  @default(false)
  synthetic Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([userId, trigger])
  @@index([trigger, createdAt])
}

model PilotCohort {
  id       String   @id @default(cuid())
  key      String   @unique
  name     String
  startsAt DateTime
  endsAt   DateTime
}

/// Cohort membership. `subjectId` is a Page id (kind PAGE) or a User id (kind SHOPPER).
model PilotMember {
  id         String   @id @default(cuid())
  cohortId   String
  kind       String
  subjectId  String
  source     String   @default("ADMIN")
  inviteCode String?
  synthetic  Boolean  @default(false)
  joinedAt   DateTime @default(now())

  @@unique([cohortId, kind, subjectId])
  @@index([kind, subjectId])
}

model PilotInvite {
  code      String    @id
  cohortId  String
  kind      String
  maxUses   Int       @default(1)
  uses      Int       @default(0)
  note      String    @default("")
  createdBy String?
  expiresAt DateTime?
  createdAt DateTime  @default(now())
}

/// Hypercare incident log (plan §8.2). PRIVACY incidents feed the Gate 3 "zero privacy incidents" criterion.
model PilotIncident {
  id         String    @id @default(cuid())
  kind       String
  summary    String
  createdBy  String?
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([kind, createdAt])
}
