// Nyambika core data model (SRS §8.1 + v2 change requests CR-02/05/06).
// Tenant isolation is enforced per page in the API layer (see docs/adr/0003-tenancy.md).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum Role {
  SHOPPER
  PAGE_OWNER
  PAGE_STAFF
  COOP_ADMIN
  COOP_MEMBER
  HOST_ADMIN
  MODERATOR
  DPO
  SUPPORT
}

enum MemberType {
  TAILOR
  COOPERATIVE
  SELLER
}

enum PageStatus {
  DRAFT
  PENDING_VERIFICATION
  PUBLISHED
  PAUSED
  SUSPENDED
  CLOSED
}

enum ProductStatus {
  DRAFT
  PENDING_APPROVAL
  PUBLISHED
  OUT_OF_STOCK
  ARCHIVED
}

enum TryOnReadiness {
  NOT_ASSESSED
  READY
  NEEDS_BETTER_PHOTO
  NOT_SUPPORTED
}

enum PayoutTarget {
  PAGE
  MAKER
}

enum OrderStatus {
  NEW
  AWAITING_PAYMENT
  PAID
  ACCEPTED
  DECLINED
  IN_PREPARATION
  READY
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
  DISPUTED
  RESOLVED
}

enum GenerationStatus {
  QUEUED
  GENERATING
  GUARDING
  DELIVERED
  WITHHELD
  FAILED
}

model User {
  id          String           @id @default(cuid())
  phone       String           @unique
  name        String?
  locale      String           @default("en")
  createdAt   DateTime         @default(now())
  deletedAt   DateTime?
  roles       RoleAssignment[]
  sessions    Session[]
  twins       Twin[]
  consents    ConsentRecord[]
  intents     IntentSession[]
  looks       Look[]
  generations Generation[]
  orders      Order[]          @relation("ShopperOrders")
  follows     Follow[]
  usage       UsageEvent[]
}

model OtpChallenge {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
}

model Session {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshHash String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
}

model RoleAssignment {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role
  pageId    String?
  page      Page?    @relation(fields: [pageId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, role, pageId])
}

model Page {
  id             String           @id @default(cuid())
  handle         String           @unique
  name           String
  memberType     MemberType
  status         PageStatus       @default(DRAFT)
  verified       Boolean          @default(false)
  story          String           @default("")
  district       String           @default("")
  sector         String           @default("")
  whatsapp       String           @default("")
  instagram      String           @default("")
  theme          String           @default("terra")
  momoMerchant   String           @default("")
  airtelMerchant String           @default("")
  allowanceOn    Boolean          @default(true)
  rating         Float            @default(0)
  reviewCount    Int              @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  roles          RoleAssignment[]
  products       Product[]
  makers         CoopMember[]
  orders         Order[]
  follows        Follow[]
  subscription   Subscription?
  sizeCharts     SizeChart[]
  usage          UsageEvent[]
}

model Follow {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, pageId])
}

/// A maker inside a cooperative page (FR-COOP-02/04/05).
model CoopMember {
  id                   String         @id @default(cuid())
  pageId               String
  page                 Page           @relation(fields: [pageId], references: [id], onDelete: Cascade)
  userId               String?
  name                 String
  phone                String         @default("")
  momoMerchant         String         @default("")
  active               Boolean        @default(true)
  attributionConsent   Boolean        @default(true)
  createdAt            DateTime       @default(now())
  products             ProductMaker[]
}

model SizeChart {
  id        String    @id @default(cuid())
  pageId    String
  page      Page      @relation(fields: [pageId], references: [id], onDelete: Cascade)
  name      String
  /// [{size:"M", chestCm:[88,94], heightRatio:[0.24,0.27]}]
  rows      Json
  products  Product[]
}

model Product {
  id             String                       @id @default(cuid())
  pageId         String
  page           Page                         @relation(fields: [pageId], references: [id], onDelete: Cascade)
  title          String
  description    String                       @default("")
  category       String
  priceRwf       Int
  madeToOrder    Boolean                      @default(false)
  leadTimeDays   Int                          @default(0)
  styles         String[]
  occasions      String[]
  fabric         String                       @default("")
  status         ProductStatus                @default(DRAFT)
  readiness      TryOnReadiness               @default(NOT_ASSESSED)
  readinessNotes String[]
  qualityScore   Float?
  payoutTarget   PayoutTarget                 @default(PAGE)
  featured       Boolean                      @default(false)
  submittedById  String?
  sizeChartId    String?
  sizeChart      SizeChart?                   @relation(fields: [sizeChartId], references: [id])
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt
  variants       Variant[]
  media          MediaAsset[]
  makers         ProductMaker[]

  @@index([pageId, status])
}

model ProductMaker {
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  coopMemberId String
  coopMember   CoopMember @relation(fields: [coopMemberId], references: [id], onDelete: Cascade)

  @@id([productId, coopMemberId])
}

model Variant {
  id          String       @id @default(cuid())
  productId   String
  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  colourName  String
  colourHex   String
  sizes       String[]
  stock       Int          @default(0)
  /// Garment cut-out used for try-on (path in the media store).
  cutoutPath  String?
  imagePath   String?
  /// Snap visual-search embedding (pgvector, cosine).
  embedding   Unsupported("vector(64)")?
  generations Generation[]
}

model MediaAsset {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  kind      String   @default("ORIGINAL")
  path      String
  width     Int      @default(0)
  height    Int      @default(0)
  createdAt DateTime @default(now())
}

/// Persistent photo twin (CR-02). Image bytes are AES-256-GCM encrypted at rest.
model Twin {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  version     Int       @default(1)
  encPath     String
  iv          String
  authTag     String
  mime        String
  size        String?
  checks      Json
  consentId   String
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?
}

/// Append-only consent ledger with a hash chain (plan §17).
model ConsentRecord {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose       String
  granted       Boolean
  noticeVersion String
  locale        String
  prevHash      String
  hash          String   @unique
  createdAt     DateTime @default(now())
}

model IntentSession {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  input     String
  source    String
  intent    Json
  createdAt DateTime @default(now())
  looks     Look[]
}

model Look {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  intentSessionId String
  intentSession   IntentSession  @relation(fields: [intentSessionId], references: [id], onDelete: Cascade)
  productId       String
  variantId       String
  rank            Int
  score           Float          @default(0)
  generationId    String?
  generation      Generation?    @relation(fields: [generationId], references: [id], onDelete: SetNull)
  savedAt         DateTime?
  createdAt       DateTime       @default(now())

  @@index([userId, savedAt])
}

model Generation {
  id           String           @id @default(cuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  variantId    String
  variant      Variant          @relation(fields: [variantId], references: [id], onDelete: Cascade)
  twinVersion  Int
  modelVersion String
  tier         String           @default("PREVIEW")
  cacheKey     String           @unique
  status       GenerationStatus @default(QUEUED)
  outputPath   String?
  guard        Json?
  c2pa         Json?
  costRwf      Int              @default(0)
  latencyMs    Int?
  createdAt    DateTime         @default(now())
  deliveredAt  DateTime?
  looks        Look[]

  @@index([userId, createdAt])
}

/// Metering for every billable AI action (FR-PLAN-02/03).
model UsageEvent {
  id        String   @id @default(cuid())
  kind      String
  source    String
  units     Int      @default(1)
  costRwf   Int      @default(0)
  pageId    String?
  page      Page?    @relation(fields: [pageId], references: [id], onDelete: SetNull)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  refId     String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([pageId, createdAt])
}

model Plan {
  code           String         @id
  name           String
  priceRwf       Int
  maxProducts    Int
  tryOnAllowance Int
  staffSeats     Int
  subscriptions  Subscription[]
}

model Subscription {
  id          String   @id @default(cuid())
  pageId      String   @unique
  page        Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  planCode    String
  plan        Plan     @relation(fields: [planCode], references: [code])
  monthlyCap  Int
  periodStart DateTime @default(now())
  sponsor     String?
}

model Order {
  id             String       @id @default(cuid())
  code           String       @unique
  pageId         String
  page           Page         @relation(fields: [pageId], references: [id])
  shopperId      String
  shopper        User         @relation("ShopperOrders", fields: [shopperId], references: [id])
  status         OrderStatus  @default(NEW)
  totalRwf       Int
  deliveryMode   String
  deliveryFeeRwf Int          @default(0)
  address        String       @default("")
  wallet         String
  payerPhone     String
  payoutMsisdn   String
  payoutLabel    String
  idempotencyKey String       @unique
  lookId         String?
  readyBy        DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  items          OrderItem[]
  events         OrderEvent[]
  payments       Payment[]
  review         Review?

  @@index([pageId, createdAt])
  @@index([shopperId, createdAt])
}

model OrderItem {
  id           String @id @default(cuid())
  orderId      String
  order        Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  variantId    String
  title        String
  colourName   String
  size         String
  qty          Int    @default(1)
  unitPriceRwf Int
  makerName    String @default("")
}

model OrderEvent {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String      @default("")
  actorId   String?
  createdAt DateTime    @default(now())
}

model Payment {
  id          String    @id @default(cuid())
  orderId     String
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider    String
  providerRef String    @unique
  status      String    @default("PENDING")
  amountRwf   Int
  payerPhone  String
  merchant    String
  webhook     Json?
  reconciled  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  settledAt   DateTime?
}

model Review {
  id        String   @id @default(cuid())
  orderId   String   @unique
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  pageId    String
  rating    Int
  text      String   @default("")
  status    String   @default("PUBLISHED")
  createdAt DateTime @default(now())
}

/// Outbox for WhatsApp / SMS / push messages (SI-03/04).
model Notification {
  id        String   @id @default(cuid())
  channel   String
  to        String
  template  String
  body      String
  status    String   @default("SENT")
  refId     String?
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  pageId    String?
  action    String
  data      Json?
  createdAt DateTime @default(now())

  @@index([pageId, createdAt])
}

model ModerationItem {
  id         String    @id @default(cuid())
  kind       String
  refId      String
  pageId     String?
  reason     String
  status     String    @default("OPEN")
  resolvedBy String?
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
}

model FeatureFlag {
  key         String  @id
  enabled     Boolean @default(false)
  rollout     Int     @default(100)
  description String  @default("")
}

model ModelVersion {
  id        String   @id
  provider  String
  name      String
  version   String
  tier      String
  status    String   @default("ACTIVE")
  nlbScore  Float?
  costRwf   Int
  createdAt DateTime @default(now())
}

/// Deletion cascade jobs (FR-PRV, plan §17 twin protection).
model DeletionJob {
  id          String    @id @default(cuid())
  userId      String
  scope       String
  status      String    @default("PENDING")
  steps       Json
  createdAt   DateTime  @default(now())
  completedAt DateTime?
}

/// Migration of existing member pages (plan §16, FR-MIG-01..05).
model MigrationWave {
  id        String          @id @default(cuid())
  name      String
  status    String          @default("IMPORTED")
  createdBy String?
  createdAt DateTime        @default(now())
  items     MigrationItem[]
}

model MigrationItem {
  id          String        @id @default(cuid())
  waveId      String
  wave        MigrationWave @relation(fields: [waveId], references: [id], onDelete: Cascade)
  pageId      String        @unique
  legacyUrl   String
  checksum    String
  /// IMPORTED → IN_REVIEW → SIGNED_OFF → LIVE | CHANGES_REQUESTED | ROLLED_BACK
  status      String        @default("IMPORTED")
  defects     Json
  reviewToken String        @unique
  ownerNote   String        @default("")
  signedOffAt DateTime?
  liveAt      DateTime?
  createdAt   DateTime      @default(now())
}

/// Legacy URL → new Maker Space. Disabling a redirect is the per-page rollback.
model Redirect {
  fromPath  String   @id
  toPath    String
  active    Boolean  @default(false)
  hits      Int      @default(0)
  createdAt DateTime @default(now())
}

/// Unmatched legacy paths, for post-cutover 404 monitoring.
model NotFoundHit {
  path     String   @id
  hits     Int      @default(1)
  lastSeen DateTime @default(now())
}

// ==== E25 Ask your circle (FR-SOC-01..03, CR-09) ====

/// A private live poll the shopper shares with friends. Watermarked copies only; originals stay private.
model CirclePoll {
  id        String         @id @default(cuid())
  ownerId   String
  token     String         @unique
  question  String
  occasion  String?
  consentId String
  ogPath    String?
  expiresAt DateTime
  revokedAt DateTime?
  purgedAt  DateTime?
  createdAt DateTime       @default(now())
  options   CircleOption[]
  votes     CircleVote[]

  @@index([ownerId, createdAt])
  @@index([expiresAt])
}

model CircleOption {
  id        String       @id @default(cuid())
  pollId    String
  poll      CirclePoll   @relation(fields: [pollId], references: [id], onDelete: Cascade)
  position  Int
  lookId    String
  productId String
  variantId String
  label     String
  /// Watermarked copy (private/polls/...), served only while the poll is open.
  imagePath String
  votes     CircleVote[]
}

/// One vote per device per poll (signed device cookie); name and comment are optional.
model CircleVote {
  id         String       @id @default(cuid())
  pollId     String
  poll       CirclePoll   @relation(fields: [pollId], references: [id], onDelete: Cascade)
  optionId   String
  option     CircleOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  deviceHash String
  ipHash     String
  name       String?
  comment    String?
  emoji      String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([pollId, deviceHash])
  @@index([pollId, createdAt])
}

// ==== E26 Digital wardrobe (FR-WRD-01..03, CR-09) ====

/// An upcoming event the shopper wants to restyle owned pieces for.
model WardrobeEvent {
  id              String           @id @default(cuid())
  userId          String
  title           String
  occasion        String
  date            DateTime
  budgetMax       Int?
  intentSessionId String?
  reminderSentAt  DateTime?
  createdAt       DateTime         @default(now())
  outfits         WardrobeOutfit[]

  @@index([userId, date])
}

/// One AI outfit suggestion: owned pieces + 0–2 new maker items, rendered on the twin.
model WardrobeOutfit {
  id          String           @id @default(cuid())
  eventId     String
  event       WardrobeEvent    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId      String
  rank        Int
  /// [{ productId, variantId, category, owned }] in render order (bottom → top).
  items       Json
  reasons     String[]
  score       Float            @default(0)
  newCostRwf  Int              @default(0)
  status      GenerationStatus @default(QUEUED)
  outputPath  String?
  guard       Json?
  c2pa        Json?
  costRwf     Int              @default(0)
  createdAt   DateTime         @default(now())
  deliveredAt DateTime?

  @@index([userId, createdAt])
}

// ==== E23 Live morph · E24 Tailor custom orders · E32 Size recommendation (FR-TRY-16, FR-SIZE-01..07, FR-CAT-07) ====

/// Private measurement profile. Every value is AES-256-GCM encrypted on its own (field-level, TWIN_KEY).
model MeasurementProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  /// { bustCm: "v1:<iv>:<tag>:<ciphertext>", ... }
  fields    Json
  /// TWIN_ESTIMATE | MANUAL
  source    String   @default("MANUAL")
  consentId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Time-limited, revocable share of the measurement profile with one tailor page for one custom order.
model MeasurementShare {
  id            String    @id @default(cuid())
  userId        String
  pageId        String
  customOrderId String?
  consentId     String
  expiresAt     DateTime
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([pageId, expiresAt])
}

/// Tailor template that makes a product customizable in the live morph (option deltas in RWF).
model MorphTemplate {
  productId String   @id
  pageId    String
  /// MorphTemplateInput (contracts)
  options   Json
  updatedAt DateTime @updatedAt

  @@index([pageId])
}

/// Cache of morphed cut-outs (one per variant + quantized spec), shared by every shopper.
model GarmentMorph {
  id         String   @id @default(cuid())
  variantId  String
  specKey    String
  cutoutPath String
  /// [x0, y0, x1, y1] of the original garment inside the morphed canvas
  frame      Json
  createdAt  DateTime @default(now())

  @@unique([variantId, specKey])
}

/// Services a tailor offers on the Maker Space (FR-CAT-07).
model TailorService {
  id                   String   @id @default(cuid())
  pageId               String
  title                String
  description          String   @default("")
  startingPriceRwf     Int
  leadTimeDays         Int      @default(7)
  requiredMeasurements String[]
  active               Boolean  @default(true)
  createdAt            DateTime @default(now())

  @@index([pageId, active])
}

/// A custom (tailor-made) order: request → quote → deposit → fittings → progress → balance → delivered.
model CustomOrder {
  id            String               @id @default(cuid())
  code          String               @unique
  pageId        String
  shopperId     String
  productId     String?
  variantId     String?
  serviceId     String?
  /// MorphSpec { hue, length, sleeve }
  spec          Json
  title         String
  estimateRwf   Int                  @default(0)
  size          String?
  note          String               @default("")
  /// Shared copy of the preview (only when the shopper explicitly shared it)
  previewPath   String?
  status        String               @default("REQUESTED")
  quotePriceRwf Int?
  depositPct    Int?
  leadTimeDays  Int?
  quoteNote     String?
  quotedAt      DateTime?
  depositRwf    Int?
  balanceRwf    Int?
  /// Backing Order (payout to the tailor's merchant account; holds the Mobile Money payments)
  orderId       String?              @unique
  readyBy       DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  events        CustomOrderEvent[]
  payments      CustomOrderPayment[]

  @@index([pageId, createdAt])
  @@index([shopperId, createdAt])
}

model CustomOrderEvent {
  id            String      @id @default(cuid())
  customOrderId String
  customOrder   CustomOrder @relation(fields: [customOrderId], references: [id], onDelete: Cascade)
  status        String
  note          String      @default("")
  actorId       String?
  createdAt     DateTime    @default(now())
}

/// Links a Mobile Money Payment (on the backing Order) to a custom-order stage.
model CustomOrderPayment {
  id            String      @id @default(cuid())
  customOrderId String
  customOrder   CustomOrder @relation(fields: [customOrderId], references: [id], onDelete: Cascade)
  paymentId     String      @unique
  /// DEPOSIT | BALANCE
  stage         String
  amountRwf     Int
  createdAt     DateTime    @default(now())
}

/// Fitting slots a tailor publishes; a shopper books one for a custom order (FR-SIZE-07).
model AppointmentSlot {
  id             String    @id @default(cuid())
  pageId         String
  startsAt       DateTime
  durationMin    Int       @default(30)
  location       String    @default("")
  bookedById     String?
  customOrderId  String?
  bookedAt       DateTime?
  reminderSentAt DateTime?
  createdAt      DateTime  @default(now())

  @@index([pageId, startsAt])
  @@index([bookedById])
}

// ==== Phase 2 Pilot and evaluation (plan §8, §21, Gate 3) ====

/// A/B experiment. Assignment is deterministic: hash(userId + ":" + key) → weighted variant.
model Experiment {
  key           String    @id
  name          String
  description   String    @default("")
  /// [{ key, weight }]; the first variant is the control.
  variants      Json
  /// DRAFT | RUNNING | PAUSED | STOPPED. Only RUNNING inside [startsAt, endsAt) assigns.
  status        String    @default("DRAFT")
  primaryMetric String
  startsAt      DateTime?
  endsAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

/// First exposure of a user to an experiment arm (operational, never shared outside aggregates).
model ExperimentExposure {
  id            String   @id @default(cuid())
  experimentKey String
  userId        String
  variant       String
  synthetic     Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@unique([experimentKey, userId])
  @@index([experimentKey, variant])
}

/// Pseudonymised product analytics event. `pseudoId` = HMAC(user or device id); props are allow-listed, no PII.
model Event {
  id         String   @id @default(cuid())
  name       String
  pseudoId   String
  authed     Boolean  @default(false)
  props      Json
  synthetic  Boolean  @default(false)
  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([name, occurredAt])
  @@index([pseudoId, name])
}

/// In-app micro-survey ("Did this help you decide?" + NPS), at most once per user per trigger.
model SurveyResponse {
  id        String   @id @default(cuid())
  userId    String
  trigger   String
  helped    Boolean?
  nps       Int?
  dismissed Boolean  @default(false)
  synthetic Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([userId, trigger])
  @@index([trigger, createdAt])
}

model PilotCohort {
  id       String   @id @default(cuid())
  key      String   @unique
  name     String
  startsAt DateTime
  endsAt   DateTime
}

/// Cohort membership. `subjectId` is a Page id (kind PAGE) or a User id (kind SHOPPER).
model PilotMember {
  id         String   @id @default(cuid())
  cohortId   String
  kind       String
  subjectId  String
  source     String   @default("ADMIN")
  inviteCode String?
  synthetic  Boolean  @default(false)
  joinedAt   DateTime @default(now())

  @@unique([cohortId, kind, subjectId])
  @@index([kind, subjectId])
}

model PilotInvite {
  code      String    @id
  cohortId  String
  kind      String
  maxUses   Int       @default(1)
  uses      Int       @default(0)
  note      String    @default("")
  createdBy String?
  expiresAt DateTime?
  createdAt DateTime  @default(now())
}

/// Hypercare incident log (plan §8.2). PRIVACY incidents feed the Gate 3 "zero privacy incidents" criterion.
model PilotIncident {
  id         String    @id @default(cuid())
  kind       String
  summary    String
  createdBy  String?
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([kind, createdAt])
}

// ==== E27 3D garment + AR view · E28 Motion preview ====

/// AI image-to-3D garment per variant (FR-3D-01a/02/03/06/07, FR-CAT-10). Member-owned public media.
/// Shown to shoppers only once the page owner approves it (FR-3D-06).
model GarmentAsset3d {
  id           String    @id @default(cuid())
  variantId    String    @unique
  productId    String
  pageId       String
  /// QUEUED | GENERATING | READY | FAILED
  status       String    @default("QUEUED")
  progress     Int       @default(0)
  approved     Boolean   @default(false)
  glbPath      String?
  posterPath   String?
  bytes        Int?
  triangles    Int?
  widthM       Float?
  heightM      Float?
  depthM       Float?
  size         String    @default("M")
  modelVersion String    @default("")
  sha256       String?
  costRwf      Int       @default(0)
  error        String?
  requestedBy  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  readyAt      DateTime?

  @@index([productId])
}

/// "See it move" motion preview of a delivered look (FR-VID-01/04/05/06). Private to the shopper.
model MotionClip {
  id           String    @id @default(cuid())
  userId       String
  lookId       String
  generationId String    @unique
  variantId    String
  pageId       String
  /// QUEUED | GENERATING | GUARDING | DELIVERED | WITHHELD | FAILED
  status       String    @default("QUEUED")
  progress     Int       @default(0)
  webpPath     String?
  mp4Path      String?
  posterPath   String?
  frames       Int?
  durationMs   Int?
  width        Int?
  height       Int?
  guard        Json?
  c2pa         Json?
  source       String?
  credits      Int       @default(0)
  costRwf      Int       @default(0)
  modelVersion String    @default("")
  error        String?
  createdAt    DateTime  @default(now())
  deliveredAt  DateTime?

  @@index([userId, createdAt])
  @@index([lookId])
}

// ==== E22/E29 Voice Muse GA · Passkeys · Optional checkout ====
// Voice (E22) stores nothing: audio lives only in memory for the length of the STT request.

/// WebAuthn credential (FR-ACC-02). Public key only; the private key never leaves the shopper's device.
model Passkey {
  id           String    @id @default(cuid())
  userId       String
  credentialId String    @unique
  publicKey    Bytes
  counter      Int       @default(0)
  transports   String[]
  deviceType   String    @default("singleDevice")
  backedUp     Boolean   @default(false)
  name         String
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  @@index([userId])
}

/// Single-use WebAuthn challenge (5 minutes). userId is null for discoverable sign-in.
model WebAuthnChallenge {
  id         String    @id @default(cuid())
  userId     String?
  kind       String
  challenge  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
}

/// Optional classic bag (FR-ORD-07 as a direct-to-maker split, CON-08): one line per variant + size.
model BagItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  variantId String
  size      String
  qty       Int      @default(1)
  lookId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, variantId, size])
  @@index([userId])
}

/// Saved delivery address, sealed with AES-256-GCM (same scheme as measurements). In privacy export/deletion.
model SavedAddress {
  id         String    @id @default(cuid())
  userId     String
  label      String
  sealed     String
  isDefault  Boolean   @default(false)
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([userId])
}

/// One bag checkout = one order + one Mobile Money request per maker payout account. Idempotent on retry.
model Checkout {
  id             String   @id @default(cuid())
  userId         String
  idempotencyKey String   @unique
  status         String   @default("PROCESSING")
  orderIds       String[]
  createdAt      DateTime @default(now())
}

// ==== E36 Agentic commerce · E37 Try-on as a Service (FR-AGT-01..06, 08) ====

/// An external AI agent or B2B partner (SRS role "API Client"). Never a shopper account.
model ApiClient {
  id                  String   @id @default(cuid())
  name                String
  /// AGENT | PARTNER
  kind                String
  contactEmail        String   @default("")
  /// ACTIVE | SUSPENDED
  status              String   @default("ACTIVE")
  /// HMAC secret for webhook signatures, sealed with AES-256-GCM (shown once on rotation).
  webhookSecretSealed String?
  createdBy           String?
  createdAt           DateTime @default(now())

  @@index([kind, status])
}

/// API key: only a peppered HMAC-SHA-256 of the secret is stored; the prefix identifies it in the UI.
model ApiKey {
  id              String    @id @default(cuid())
  clientId        String
  name            String    @default("")
  prefix          String    @unique
  hash            String    @unique
  /// LIVE | SANDBOX (sandbox partner results are watermarked and never billed)
  env             String    @default("LIVE")
  scopes          String[]
  rateLimitPerMin Int       @default(120)
  /// Calls per calendar month (null = unlimited)
  monthlyQuota    Int?
  expiresAt       DateTime?
  revokedAt       DateTime?
  lastUsedAt      DateTime?
  createdBy       String?
  createdAt       DateTime  @default(now())

  @@index([clientId])
}

/// Audit log of every agent/partner call (FR-AGT-08). IPs are stored only as an HMAC.
model AgentCall {
  id        String   @id @default(cuid())
  clientId  String?
  keyId     String?
  method    String
  route     String
  tool      String?
  status    Int
  latencyMs Int
  ipHash    String
  createdAt DateTime @default(now())

  @@index([clientId, createdAt])
  @@index([createdAt])
}

/// Member opt-in/out of agent channels and external marketplaces (FR-AGT-05). No row = opted in.
model AgentChannelSetting {
  pageId              String   @id
  agentsEnabled       Boolean  @default(true)
  marketplacesEnabled Boolean  @default(true)
  updatedBy           String?
  updatedAt           DateTime @updatedAt
}

/// Agent-initiated checkout session (ACP/UCP aligned). Nothing is ordered or paid until the shopper
/// confirms the signed, single-use, expiring mandate inside Nyambika (FR-AGT-04).
model AgentCheckout {
  id               String    @id @default(cuid())
  clientId         String
  keyId            String
  pageId           String
  /// AWAITING_CONFIRMATION | CONFIRMED | CANCELED | EXPIRED (payment state comes from the order)
  status           String    @default("AWAITING_CONFIRMATION")
  /// [{ productId, variantId, title, colourName, size, qty, unitPriceRwf, makerName }]
  items            Json
  itemsHash        String
  subtotalRwf      Int
  payoutLabel      String
  currency         String    @default("RWF")
  mandateNonce     String    @unique
  mandateExpiresAt DateTime
  mandateUsedAt    DateTime?
  confirmedById    String?
  orderId          String?   @unique
  idempotencyKey   String
  externalRef      String?
  /// REST | MCP
  channel          String    @default("REST")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([clientId, idempotencyKey])
  @@index([createdAt])
  @@index([pageId])
}

/// B2B try-on contract (FR-AGT-06): monthly quota, fee and overage price.
model PartnerContract {
  id              String    @id @default(cuid())
  clientId        String    @unique
  /// DRAFT | ACTIVE | SUSPENDED | ENDED
  status          String    @default("DRAFT")
  monthlyQuota    Int       @default(1000)
  monthlyFeeRwf   Int       @default(0)
  overagePriceRwf Int       @default(150)
  /// true: stop at the quota; false: allow overage at overagePriceRwf
  hardCap         Boolean   @default(false)
  sandboxDailyCap Int       @default(50)
  startsAt        DateTime  @default(now())
  endsAt          DateTime?
  notes           String    @default("")
  updatedBy       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

/// One partner try-on call: garment + synthetic AI model only (never a Nyambika shopper's twin).
model PartnerTryonJob {
  id              String    @id @default(cuid())
  clientId        String
  keyId           String
  sandbox         Boolean   @default(false)
  /// QUEUED | GENERATING | GUARDING | DELIVERED | WITHHELD | FAILED
  status          String    @default("QUEUED")
  modelId         String
  category        String
  garmentPath     String
  outputPath      String?
  guard           Json?
  c2pa            Json?
  modelVersion    String    @default("")
  clientReference String?
  webhookUrl      String?
  /// NONE | PENDING | DELIVERED | FAILED
  webhookStatus   String    @default("NONE")
  webhookAttempts Int       @default(0)
  webhookLastAt   DateTime?
  billable        Boolean   @default(false)
  overage         Boolean   @default(false)
  priceRwf        Int       @default(0)
  costRwf         Int       @default(0)
  latencyMs       Int?
  error           String?
  idempotencyKey  String?
  createdAt       DateTime  @default(now())
  deliveredAt     DateTime?

  @@unique([clientId, idempotencyKey])
  @@index([clientId, createdAt])
}

// ==== E30 Member growth tools (FR-PHO-07, FR-ANL-01/03, FR-PAGE-05) ====

/// Maker-funded discount code or time-boxed offer (no code = applied automatically). Never platform-funded.
model DiscountCode {
  id          String    @id @default(cuid())
  pageId      String
  /// Upper-case code shoppers type; null for an automatic time-boxed offer.
  code        String?
  label       String    @default("")
  /// PERCENT (value = 1..90) | AMOUNT (value = RWF)
  kind        String
  value       Int
  productId   String?
  minSpendRwf Int       @default(0)
  maxUses     Int?
  perShopper  Int       @default(1)
  uses        Int       @default(0)
  startsAt    DateTime  @default(now())
  endsAt      DateTime?
  active      Boolean   @default(true)
  /// Always MAKER: the shopper pays the maker less; the platform never tops up.
  fundedBy    String    @default("MAKER")
  createdBy   String
  createdAt   DateTime  @default(now())

  @@unique([pageId, code])
  @@index([pageId, active])
}

model DiscountRedemption {
  id         String   @id @default(cuid())
  discountId String
  orderId    String   @unique
  shopperId  String
  pageId     String
  amountRwf  Int
  createdAt  DateTime @default(now())

  @@index([discountId, shopperId])
}

/// Follower opt-in for WhatsApp "new collection" broadcasts (explicit and revocable, separate from following).
model BroadcastOptIn {
  userId    String
  pageId    String
  optedIn   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([userId, pageId])
  @@index([pageId, optedIn])
}

model Broadcast {
  id         String   @id @default(cuid())
  pageId     String
  createdBy  String
  kind       String   @default("NEW_COLLECTION")
  message    String
  productIds String[]
  link       String
  recipients Int      @default(0)
  skipped    Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([pageId, createdAt])
}

// ==== E31 Low-literacy cooperative flows (FR-COOP-07..09, UI-06) ====

/// Per-maker accessibility settings, set by the cooperative admin.
model MakerAccess {
  coopMemberId String   @id
  pageId       String
  /// Voice-and-icon studio mode (big pictograms, spoken prompts).
  voiceMode    Boolean  @default(false)
  /// SMS notices and the USSD menu for makers without a smartphone.
  smsMode      Boolean  @default(false)
  locale       String   @default("rw")
  updatedAt    DateTime @updatedAt
}

/// Maker's recorded consent for the cooperative admin to act on their behalf ("assisted mode").
model AssistGrant {
  id           String    @id @default(cuid())
  pageId       String
  coopMemberId String
  requestedBy  String
  /// PENDING → ACTIVE → REVOKED | EXPIRED
  status       String    @default("PENDING")
  /// How the maker agreed: SMS_CODE (read the code to the admin) or USSD (approved on their own phone).
  method       String?
  codeHash     String
  scopes       String[]
  consentText  String
  consentId    String?
  attempts     Int       @default(0)
  grantedAt    DateTime?
  expiresAt    DateTime?
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([coopMemberId, status])
}

// ==== E21 Full-network migration (FR-MIG-04/05) ====

/// Queue-driven run of a (large) wave: per-wave concurrency window, outreach cadence, cut-over checklist.
model MigrationRun {
  waveId      String    @id
  concurrency Int       @default(4)
  total       Int
  done        Int       @default(0)
  failed      Int       @default(0)
  /// QUEUED → RUNNING → IMPORTED | ROLLED_BACK
  status      String    @default("QUEUED")
  bundlePath  String
  cadenceDays Int[]     @default([2, 5, 9])
  checklist   Json      @default("{}")
  maxRunning  Int       @default(0)
  createdBy   String?
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime  @default(now())
}

model MigrationJob {
  id         String    @id @default(cuid())
  waveId     String
  index      Int
  handle     String
  /// PENDING → ENQUEUED → RUNNING → DONE | FAILED
  status     String    @default("PENDING")
  error      String?
  itemId     String?
  startedAt  DateTime?
  finishedAt DateTime?

  @@unique([waveId, index])
  @@index([waveId, status])
}

/// Owner outreach log (invites + reminders) for auto-chasing unsigned pages.
model MigrationOutreach {
  id     String   @id @default(cuid())
  itemId String
  waveId String
  /// INVITE | REMINDER
  kind   String
  seq    Int      @default(0)
  sentAt DateTime @default(now())

  @@index([itemId])
  @@index([waveId, kind])
}

// ==== E33 3D twin + E34 3D try-on / AR mirror ====

/// Animatable 3D twin (FR-AVA-01..06). Separate AVATAR_3D consent. Capture frames, body parameters and the GLB are
/// AES-256-GCM encrypted at rest and served to the owner only through short-lived signed URLs; never to makers.
model Avatar3d {
  id           String    @id @default(cuid())
  userId       String
  version      Int       @default(1)
  /// TURNAROUND (camera turn capture) | PERSONA (synthetic turnaround, non-production) | MEASUREMENTS (body-shape only, FR-AVA-06)
  source       String
  persona      Int?
  /// QUEUED | BUILDING | READY | REJECTED | WITHHELD | FAILED
  status       String    @default("QUEUED")
  progress     Int       @default(0)
  framesPath   String?
  framesIv     String?
  framesTag    String?
  frameCount   Int       @default(0)
  /// Sealed JSON { measurements, skin_rgb, size_estimate } used to (re)build and dress the avatar.
  paramsSealed String?
  glbPath      String?
  glbIv        String?
  glbTag       String?
  posterPath   String?
  posterIv     String?
  posterTag    String?
  bytes        Int?
  triangles    Int?
  joints       Int?
  checks       Json?
  eval         Json?
  provider     String    @default("parametric-cpu")
  modelVersion String    @default("")
  gatewayJob   String?
  consentId    String
  error        String?
  createdAt    DateTime  @default(now())
  readyAt      DateTime?
  deletedAt    DateTime?

  @@index([userId, createdAt])
}

/// A garment fitted on a 3D twin (FR-FIT-01): one per avatar version + variant + size. Private like the avatar.
model AvatarFit3d {
  id           String   @id @default(cuid())
  avatarId     String
  userId       String
  variantId    String
  productId    String
  size         String
  /// QUEUED | READY | FAILED
  status       String   @default("QUEUED")
  glbPath      String?
  glbIv        String?
  glbTag       String?
  posterPath   String?
  posterIv     String?
  posterTag    String?
  bytes        Int?
  triangles    Int?
  fit          Json?
  modelVersion String   @default("")
  error        String?
  createdAt    DateTime @default(now())

  @@unique([avatarId, variantId, size])
  @@index([userId])
}

// ==== E39 Video try-on + E42 Self-hosted inference ====

/// Evaluation records in the model registry (AI-BM-04). E39 gate: a VIDEO_TRYON model cannot be activated
/// without a passing NLB_VIDEO record for its exact version, newer than a quarter, on a commercial licence.
model ModelEval {
  id            String   @id @default(cuid())
  modelId       String
  /// NLB_VIDEO
  kind          String
  /// Version the provider reported while evaluated; must equal modelId for the gate to accept it.
  modelVersion  String
  passed        Boolean
  licence       String   @default("")
  commercialUse Boolean  @default(false)
  summary       Json
  report        Json
  createdBy     String?
  createdAt     DateTime @default(now())

  @@index([modelId, createdAt])
}

/// "See it on video" (FR-VID-03/04/05). Private to the shopper. A CLIP source is the shopper's own frames
/// (VIDEO_CLIP_UPLOAD consent), AES-256-GCM sealed and deleted as soon as processing ends (clipDeletedAt).
model VideoTryOn {
  id            String    @id @default(cuid())
  userId        String
  lookId        String
  generationId  String?
  variantId     String
  pageId        String
  /// CLIP | TURNAROUND
  source        String
  /// QUEUED | GENERATING | GUARDING | DELIVERED | WITHHELD | FAILED
  status        String    @default("QUEUED")
  progress      Int       @default(0)
  modelId       String
  provider      String
  clipPath      String?
  clipIv        String?
  clipTag       String?
  clipFrames    Int       @default(0)
  clipDeletedAt DateTime?
  consentId     String?
  gatewayJob    String?
  webpPath      String?
  mp4Path       String?
  posterPath    String?
  frames        Int?
  durationMs    Int?
  width         Int?
  height        Int?
  guard         Json?
  c2pa          Json?
  routing       Json?
  billing       String?
  credits       Int       @default(0)
  costRwf       Int       @default(0)
  modelVersion  String    @default("")
  error         String?
  createdAt     DateTime  @default(now())
  deliveredAt   DateTime?

  @@index([userId, createdAt])
  @@index([lookId])
}

/// Inference routing policy (E42, AI-GW-07). One row ("default"); the API pushes it to the gateway by version.
model InferencePolicy {
  id        String   @id
  policy    Json
  version   Int      @default(1)
  updatedBy String?
  updatedAt DateTime @updatedAt
}
